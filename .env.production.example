# Separate production Supabase project. Never reuse staging keys or project ref.
SITE_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://PRODUCTION_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_PRODUCTION_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_PRODUCTION_SERVICE_ROLE_KEY
